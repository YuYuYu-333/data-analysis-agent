# 复制本文件为 .env，填入自己的密钥
# .env 不提交仓库；密钥永远不打印、不发给任何人

# 必需：DeepSeek（生成 SQL / 陈述）
DEEPSEEK_API_KEY=

# 必需：硅基流动（schema.md 向量化）
SILICONFLOW_API_KEY=

# 可选：多轮检查点；不填用 data/checkpoints.db
CHECKPOINT_DB=

# 可选：云端 Postgres（M6 接 Neon）
DATABASE_URL=

# 其余可选项（API_KEY / 限流配额 / DEBUG）在对应功能实现时再加；
# 不填就用 app/config.py 里的默认值。
